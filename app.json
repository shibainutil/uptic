{
  "expo": {
    "name": "Uptic",
    "slug": "uptic",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "uptic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uptic.app"
    },
    "android": {
      "package": "com.uptic.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2F6FF0",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/splash-empty.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/splash-empty.png"
          }
        }
      ],
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6FF0"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Uptic needs access to your photos to add images to exercises.",
          "cameraPermission": "Uptic needs access to your camera to take exercise photos."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/bedf55f1-d06f-47e3-9156-77e99ab6b710",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "master"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bedf55f1-d06f-47e3-9156-77e99ab6b710"
      },
      "googleWebClientId": "752330312289-3habolld4fn9olio688d6l7afbafmfeh.apps.googleusercontent.com"
    },
    "owner": "anton.immel"
  }
}
